---
import { profile } from "../lib/profile";

// Only links that resolve today.
const links = [
  { label: "Work", href: "/#work" },
  { label: "Resume", href: "/resume.pdf" },
  { label: "GitHub", href: profile.github },
];
---

<header class="nav glass" data-glass="">
  <canvas class="glass-canvas" aria-hidden="true"></canvas>
  <a class="brand" href="/"><span class="first">Aung</span><span class="rest">Koko Lwin</span></a>
  <nav aria-label="Main">
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
    <button class="theme" type="button" aria-label="Switch theme" data-theme-toggle>
      <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path></svg>
    </button>
    <a class="cta" href="/#contact">Let's talk</a>
    <button class="theme menu-button" type="button" popovertarget="nav-menu" aria-label="Menu">
      <svg class="burger" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16"></path><path d="M4 12h16"></path><path d="M4 17h16"></path></svg>
    </button>
    <span class="glass glass-drop" data-glass="" aria-hidden="true"></span>
  </nav>
  <!-- Phone menu: a native popover, so Esc and a tap outside close it with no script. -->
  <div class="menu glass" id="nav-menu" popover data-glass="">
    <canvas class="glass-canvas" aria-hidden="true"></canvas>
    <a href="/#contact">Let's talk</a>
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
    <span class="glass glass-drop" data-glass="" aria-hidden="true"></span>
  </div>
</header>

<style>
  /* A floating glass capsule that stays on screen; sticky, so the page below never jumps under it. The blur
     shows text through it; WebGPU adds the rim light. */
  .nav {
    position: sticky;
    top: 0.75rem;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0.75rem max(0.75rem, calc((100% - var(--page-max)) / 2)) 0;
    padding: 0.625rem 0.75rem 0.625rem 1.5rem;
    border: 1px solid color-mix(in srgb, var(--fg) 12%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 60%, transparent);
    backdrop-filter: blur(16px) saturate(1.6);
    /* Dense enough that the name stays readable over the bright hero photo. */
    --glass-tint: color-mix(in srgb, var(--bg) 45%, transparent);
    --glass-blur: 3px;
  }
  /* Wordmark: bold serif first name, italic family name tucked under its right edge. */
  .brand {
    display: inline-grid;
    justify-items: end;
    margin-right: auto;
    border-radius: 4px;
    color: var(--fg);
    text-decoration: none;
    line-height: 1;
  }
  .first {
    font-family: var(--serif);
    font-size: 1.625rem;
    font-weight: 900;
    font-synthesis-weight: auto;
    letter-spacing: -0.01em;
    line-height: 0.85;
  }
  /* A little space so the tail of the g never touches the second line. */
  .rest {
    margin-top: 0.3rem;
    font-family: Georgia, serif;
    font-size: 0.6875rem;
    font-style: italic;
  }
  .brand:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 2px;
  }
  nav {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    font-size: 0.875rem;
  }
  .brand,
  nav a {
    white-space: nowrap;
  }
  nav a {
    color: var(--muted);
    text-decoration: none;
  }
  nav a:hover,
  nav a:focus-visible {
    color: var(--fg);
  }
  nav .cta {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--fg);
  }
  /* Shows the current theme: sun in light, moon in dark, whether chosen or from the system. */
  .theme {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-control);
    background: none;
    color: var(--fg);
    cursor: pointer;
  }
  .theme:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 2px;
  }
  .theme svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .moon,
  :global(:root[data-theme="dark"]) .sun {
    display: none;
  }
  :global(:root[data-theme="dark"]) .moon {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .sun {
      display: none;
    }
    :global(:root:not([data-theme="light"])) .moon {
      display: block;
    }
  }

  .menu-button {
    display: none;
  }
  /* Hamburger to X; matching transform lists on both ends keep the tween smooth. */
  .burger path {
    transform-box: view-box;
    transform-origin: 12px 12px;
    transition:
      transform 320ms cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 200ms;
  }
  .burger path:nth-child(3) {
    transform: rotate(0) translate(-3px, 0) scale(0.625, 1);
  }
  :global(.nav:has(.menu:popover-open)) .burger path:nth-child(1) {
    transform: rotate(45deg) translate(0, 5px);
  }
  :global(.nav:has(.menu:popover-open)) .burger path:nth-child(2) {
    opacity: 0;
    transform: scale(0, 1);
  }
  :global(.nav:has(.menu:popover-open)) .burger path:nth-child(3) {
    transform: rotate(-45deg) translate(0, -5px) scale(1, 1);
  }
  @media (prefers-reduced-motion: reduce) {
    .burger path {
      transition: none;
    }
  }
  .menu {
    inset: 5.25rem 1rem auto auto;
    width: 13rem;
    margin: 0;
    padding: 0.375rem;
    border: 1px solid color-mix(in srgb, var(--fg) 12%, transparent);
    /* Even corners: the lens map assumes one radius all round. */
    border-radius: var(--radius-card);
    background: color-mix(in srgb, var(--bg) 70%, transparent);
    backdrop-filter: blur(16px) saturate(1.6);
    color: var(--fg);
    box-shadow: 0 8px 30px rgb(0 0 0 / 0.2);
    /* More blur than the nav, so the links stay readable over the page. */
    --glass-tint: color-mix(in srgb, var(--bg) 35%, transparent);
    --glass-blur: 4px;
  }
  .menu:popover-open {
    display: grid;
  }
  .menu a {
    padding: 0 0.75rem;
    border-radius: var(--radius-control);
    color: var(--fg);
    line-height: 44px;
    text-decoration: none;
  }
  .menu a:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: -2px;
  }

  /* Phones: name, theme and a menu button; every link moves into the menu. */
  @media (max-width: 30rem) {
    nav a,
    nav .cta {
      display: none;
    }
    .menu-button {
      display: grid;
    }
    nav {
      gap: 0.25rem;
    }
  }
  @media (min-width: 30.01rem) {
    .menu {
      display: none;
    }
  }
</style>

<script>
  import "../scripts/theme-toggle";
  import "../scripts/nav-menu";
</script>
