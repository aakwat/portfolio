---
import { profile } from "../lib/profile";
---

<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="text">
    <h2 id="contact-title">Let's talk.</h2>
    <p class="intro">I build web apps from concept to production, and I'm open to new work.</p>
    <p><a class="mail" href={`mailto:${profile.email}`}>{profile.email}</a></p>
    <ul class="links">
      <li><a href={profile.github}>GitHub</a></li>
      <li><a href={profile.linkedin}>LinkedIn</a></li>
      <li><a href="/resume.pdf">Resume</a></li>
    </ul>
  </div>
</section>

<style>
  .contact {
    display: grid;
    align-items: center;
    gap: 3rem;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 6rem 1.5rem 7rem;
    border-top: 1px solid var(--line);
  }
  h2 {
    margin: 0;
    font-size: var(--text-xl);
    letter-spacing: -0.03em;
    font-weight: 400;
    line-height: 1;
  }
  .intro {
    max-width: 30ch;
    margin: 1.25rem 0;
    color: var(--muted);
  }
  .mail {
    font-size: var(--text-md);
    text-underline-offset: 0.2em;
  }
  .links {
    display: flex;
    gap: 1.25rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }
  /* A grid track may shrink below its longest word only with this; the email is one long word. */
  .text {
    min-width: 0;
  }
  @media (max-width: 40rem) {
    .mail {
      font-size: var(--text-sm);
      overflow-wrap: anywhere;
    }
    .contact {
      padding: 4rem 1.25rem 5rem;
    }
  }
</style>
