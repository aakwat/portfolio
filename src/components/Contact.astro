---
import avatar from "../lib/avatar.json";
import { profile } from "../lib/profile";

// Traced from assets/me-transparent.png: pen-loop hair, face outline, shirt outline and fill strokes.
const [hairA = "", hairB = "", hairC = ""] = avatar.hair;
---

<section class="contact" id="contact" aria-labelledby="contact-title" data-fb-scene="contact" data-fb-name="Let's talk">
  <div class="text">
    <h2 id="contact-title" data-fb="heading" data-fb-name="Heading">Let's talk.</h2>
    <p class="intro" data-fb="intro" data-fb-name="Intro">I build web apps from concept to production, and I'm open to new work.</p>
    <p data-fb="mail" data-fb-name="Email"><a class="mail" href={`mailto:${profile.email}`}>{profile.email}</a></p>
    <ul class="links" data-fb="links" data-fb-name="Links">
      <li><a href={profile.github}>GitHub</a></li>
      <li><a href={profile.linkedin}>LinkedIn</a></li>
      <li><a href="/resume.pdf">Resume</a></li>
    </ul>
  </div>

  <svg class="avatar" viewBox={`-6 -6 ${avatar.width + 12} ${avatar.height + 5}`} role="img" aria-label={`Line drawing of ${profile.name}`} data-fb="avatar" data-fb-name="Portrait">
    <defs>
      <clipPath id="avatar-shirt"><path d={avatar.shirt} /></clipPath>
    </defs>
    <path class="pen hair a" pathLength="1" d={hairA} />
    <path class="pen hair b" pathLength="1" d={hairB} />
    <path class="pen hair c" pathLength="1" d={hairC} />
    <path class="pen line face" pathLength="1" d={avatar.face} />
    <path class="pen fill" pathLength="1" clip-path="url(#avatar-shirt)" d={avatar.shirtFill} />
    <path class="pen line shirt" pathLength="1" d={avatar.shirt} />
  </svg>
</section>

<style>
  .contact {
    display: grid;
    grid-template-columns: 1fr minmax(0, 22rem);
    align-items: center;
    gap: 3rem;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 6rem 1.5rem 7rem;
    border-top: 1px solid var(--line);
  }
  h2 {
    margin: 0;
    font-size: var(--text-xl);
    letter-spacing: -0.03em;
    font-weight: 400;
    line-height: 1;
  }
  .intro {
    max-width: 30ch;
    margin: 1.25rem 0;
    color: var(--muted);
  }
  .mail {
    font-size: var(--text-md);
    text-underline-offset: 0.2em;
  }
  .links {
    display: flex;
    gap: 1.25rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }
  .avatar {
    width: 100%;
    /* The shirt runs on past the bottom edge; cut it there, like a cropped photo. */
    overflow: hidden;
  }
  .pen {
    fill: none;
    stroke: var(--fg);
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .hair,
  .line {
    stroke-width: 1.6;
    vector-effect: non-scaling-stroke;
  }
  /* Wider than the 2.5-unit gap between strokes, so the finished fill is solid. */
  .fill {
    stroke-width: 3.4;
  }

  /* A grid track may shrink below its longest word only with this; the email is one long word. */
  .text {
    min-width: 0;
  }
  @media (max-width: 40rem) {
    .mail {
      font-size: var(--text-sm);
      overflow-wrap: anywhere;
    }
    .contact {
      grid-template-columns: 1fr 7.5rem;
      align-items: end;
      gap: 1rem;
      padding: 4rem 1.25rem 5rem;
    }
  }
</style>
