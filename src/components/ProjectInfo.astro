---
import type { Project } from "../lib/projects";

interface Props {
  project: Project;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
---

<div class:list={["info", { featured }]}>
  <h3>
    {project.name}
    {project.badge && <span class="badge">{project.badge}</span>}
  </h3>
  <p class="line">{project.line}</p>
  {
    featured && project.facts && (
      <ul class="facts">
        {project.facts.map((fact) => <li>{fact}</li>)}
      </ul>
    )
  }
  <ul class="tags" aria-label="Built with">
    {project.tags.map((tag) => <li>{tag}</li>)}
  </ul>
  <p class="links">
    {project.links.map((link) => <a href={link.href} rel="noopener">{link.label} <span aria-hidden="true">↗</span></a>)}
  </p>
</div>

<style>
  h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 1rem 0 0.25rem;
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1.15;
  }
  .featured h3 {
    margin-top: 0;
    font-size: 2rem;
  }
  .badge {
    padding: 0.125rem 0.5rem;
    border-radius: 8px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 0.75rem;
    line-height: 1.4;
  }
  .line {
    max-width: 42ch;
    margin: 0;
    color: var(--muted);
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .facts {
    display: grid;
    gap: 0.375rem;
    margin-top: 1rem;
    font-size: 0.9375rem;
  }
  .facts li::before {
    content: "→ ";
    color: var(--muted);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.875rem;
  }
  .tags li {
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--muted);
    font-size: 0.75rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
    margin: 0.25rem 0 0;
  }
  .links a {
    display: inline-block;
    line-height: 40px;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
