---
import { projects } from "../lib/projects";
import ProjectInfo from "./ProjectInfo.astro";
import ProjectMedia from "./ProjectMedia.astro";

const [featured, ...rest] = projects;
---

<section class="work" id="work" aria-labelledby="work-title" data-fb-scene="work" data-fb-name="Work">
  <header class="head">
    <h2 id="work-title" data-fb="heading" data-fb-name="Heading">Work</h2>
    <p data-fb="intro" data-fb-name="Intro">Things I have built, from first sketch to production.</p>
  </header>

  {
    featured && (
      <article class="card feature" data-fb-box>
        <div class="frame" data-fb-frame>
          <ProjectMedia media={featured.media} label={featured.name} />
        </div>
        <ProjectInfo project={featured} featured />
      </article>
    )
  }

  <div class="grid">
    {
      rest.map((project) => (
        <article class="card" data-fb-box data-fb-card data-fb-name={project.name}>
          <div class="frame" data-fb-frame>
            <ProjectMedia media={project.media} label={project.name} />
          </div>
          <ProjectInfo project={project} />
        </article>
      ))
    }
  </div>
</section>

<script>
  import "../scripts/media";
</script>

<style>
  .work {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 6rem 1.5rem 5rem;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: 2.5rem;
  }
  h2 {
    margin: 0;
    font-size: var(--text-xl);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .head p {
    max-width: 22rem;
    margin: 0;
    color: var(--muted);
  }
  /* Each project sits in a bordered card; the media inside uses a smaller radius so the corners nest. */
  .card {
    padding: 0.75rem 0.75rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--card);
  }
  .frame {
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--bg);
  }
  .card :global(.info) {
    padding: 0 0.5rem;
  }
  .feature {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 2rem;
    align-items: center;
    margin-bottom: 1.5rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 60rem) {
    .feature {
      grid-template-columns: 1fr;
    }
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 40rem) {
    .work {
      padding: 4rem 1rem 3rem;
    }
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
