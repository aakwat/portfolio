---
import { profile } from "../lib/profile";

// Only links that resolve today.
const links = [
  { label: "Work", href: "/#work" },
  { label: "Resume", href: "/resume.pdf" },
  { label: "GitHub", href: profile.github },
];
---

<header class="nav glass" data-glass="" data-glass-lens="nav-lens">
  <canvas class="glass-canvas" aria-hidden="true"></canvas>
  <a class="brand" href="/"><span class="first">Aung</span><span class="rest">Koko Lwin</span></a>
  <nav aria-label="Main">
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
    <button class="theme" type="button" aria-label="Switch theme" data-theme-toggle>
      <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path></svg>
    </button>
    <a class="cta" href="/#contact">Let's talk</a>
    <button class="theme menu-button" type="button" popovertarget="nav-menu" aria-label="Menu">
      <svg class="bars" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10"></path></svg>
      <svg class="cross" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
    </button>
  </nav>
  <!-- Phone menu: a native popover, so Esc and a tap outside close it with no script. -->
  <div class="menu" id="nav-menu" popover>
    <a href="/#contact">Let's talk</a>
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
  </div>
</header>

<!-- The nav's lens: scripts/glass/lens.ts fills in the map and the shift. sRGB, so the map's bytes are read as-is. -->
<svg class="lens-defs" aria-hidden="true" focusable="false">
  <filter id="nav-lens" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
    <feImage result="map" x="0" y="0" width="1" height="1" preserveAspectRatio="none"></feImage>
    <feDisplacementMap in="SourceGraphic" in2="map" scale="0" xChannelSelector="R" yChannelSelector="G" result="bent"></feDisplacementMap>
    <feGaussianBlur in="bent" stdDeviation="1" result="soft"></feGaussianBlur>
    <feColorMatrix in="soft" type="saturate" values="1.6"></feColorMatrix>
  </filter>
</svg>

<style>
  /* A floating glass capsule that stays on screen; sticky, so the page below never jumps under it. The blur
     shows text through it; WebGPU (scripts/glass) adds the rim light. */
  .nav {
    position: sticky;
    top: 0.75rem;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0.75rem max(0.75rem, calc((100% - var(--page-max)) / 2)) 0;
    padding: 0.625rem 0.75rem 0.625rem 1.5rem;
    border: 1px solid color-mix(in srgb, var(--fg) 12%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 60%, transparent);
    backdrop-filter: blur(16px) saturate(1.6);
  }
  /* Real refraction once the lens map is ready (Chromium): a lighter tint, so the bending shows. */
  .nav[data-lens-live] {
    background: color-mix(in srgb, var(--bg) 30%, transparent);
    backdrop-filter: url(#nav-lens);
  }
  /* Holds the filter only; a hidden (display: none) SVG would break the url() reference. */
  .lens-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
  /* Wordmark: bold serif first name, italic family name tucked under its right edge. */
  .brand {
    display: inline-grid;
    justify-items: end;
    margin-right: auto;
    border-radius: 4px;
    color: var(--fg);
    text-decoration: none;
    line-height: 1;
  }
  .first {
    font-family: var(--serif);
    font-size: 1.625rem;
    font-weight: 900;
    font-synthesis-weight: auto;
    letter-spacing: -0.01em;
    line-height: 0.85;
  }
  /* A little space so the tail of the g never touches the second line. */
  .rest {
    margin-top: 0.3rem;
    font-family: Georgia, serif;
    font-size: 0.6875rem;
    font-style: italic;
  }
  .brand:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 2px;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    font-size: 0.875rem;
  }
  .brand,
  nav a {
    white-space: nowrap;
  }
  nav a {
    color: var(--muted);
    text-decoration: none;
  }
  nav a:hover,
  nav a:focus-visible {
    color: var(--fg);
  }
  nav .cta {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--fg);
  }
  /* Shows the current theme: sun in light, moon in dark, whether chosen or from the system. */
  .theme {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-control);
    background: none;
    color: var(--fg);
    cursor: pointer;
  }
  .theme:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 2px;
  }
  .theme svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .moon,
  :global(:root[data-theme="dark"]) .sun {
    display: none;
  }
  :global(:root[data-theme="dark"]) .moon {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .sun {
      display: none;
    }
    :global(:root:not([data-theme="light"])) .moon {
      display: block;
    }
  }

  .menu-button,
  .cross,
  :global(.nav:has(.menu:popover-open)) .bars {
    display: none;
  }
  :global(.nav:has(.menu:popover-open)) .cross {
    display: block;
  }
  .menu {
    inset: 5.25rem 1rem auto auto;
    width: 13rem;
    margin: 0;
    padding: 0.375rem;
    border: 1px solid var(--line);
    border-radius: 0 14px 14px 14px;
    background: var(--bg);
    color: var(--fg);
    box-shadow: 0 8px 30px rgb(0 0 0 / 0.2);
  }
  .menu:popover-open {
    display: grid;
  }
  .menu a {
    padding: 0 0.75rem;
    border-radius: var(--radius-control);
    color: var(--fg);
    line-height: 44px;
    text-decoration: none;
  }
  .menu a:first-child,
  .menu a:hover,
  .menu a:focus-visible {
    background: var(--line);
  }

  /* Phones: name, theme and a menu button; every link moves into the menu. */
  @media (max-width: 30rem) {
    nav a,
    nav .cta {
      display: none;
    }
    .menu-button {
      display: grid;
    }
    nav {
      gap: 0.25rem;
    }
  }
  @media (min-width: 30.01rem) {
    .menu {
      display: none;
    }
  }
</style>

<script>
  import "../scripts/theme-toggle";
  import "../scripts/nav-menu";
</script>
