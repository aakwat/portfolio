---
import { profile } from "../lib/profile";
---

<section class="hero" aria-labelledby="hero-name" data-fb-scene="hero">
  <div class="col"><span class="glyph" aria-hidden="true" data-fb="glyph" data-fb-name="Letter A">A</span></div>
  <div class="col photo-col">
    <img
      class="photo"
      src="/portrait.jpg"
      alt={profile.name}
      width="640"
      height="640"
      fetchpriority="high"
      decoding="async"
      data-fb="photo"
    />
    <span class="glyph" aria-hidden="true" data-fb="glyph" data-fb-name="Letter U">U</span>
    <p class="hello" data-fb="hello" data-fb-name="Greeting">Hello, I'm Aung</p>
  </div>
  <div class="col"><span class="glyph" aria-hidden="true" data-fb="glyph" data-fb-name="Letter N">N</span></div>
  <div class="col">
    <span class="glyph" aria-hidden="true" data-fb="glyph" data-fb-name="Letter G">G</span>
    <small class="copy" data-fb="copyright" data-fb-name="Copyright">© 2026 {profile.name}</small>
  </div>

  <div class="caption">
    <p class="wave" aria-hidden="true" data-fb="wave" data-fb-name="AUNG"><span>A</span><span>U</span><span>N</span><span>G</span></p>
    <h1 id="hero-name" data-fb="name" data-fb-name="Name">{profile.name}</h1>
    <p data-fb="summary" data-fb-name="Summary">{profile.summary}</p>
    <a href="/resume.pdf" data-fb="link" data-fb-name="Link">View resume <span aria-hidden="true">↙</span></a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    container-type: inline-size;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    height: clamp(34rem, calc(100svh - 4.5rem), 48rem);
    border-top: 1px solid var(--line);
    /* One letter size for glyphs and caption placement; capped so wide screens can't overflow the height. */
    --glyph: min(25cqw, 17rem);
    --serif: Didot, "Bodoni 72", "Bodoni Moda", "Playfair Display", "Noto Serif Display", "Noto Serif", Georgia, serif;
    /* Letter height inside its column: 0 touches the top, 1 touches the bottom. */
    --box: calc(var(--glyph) * 0.8);
    --y-a: 0.5;
    --y-u: 0.7;
    --y-n: 0.3;
    --y-g: 0.9;
  }
  .col {
    position: relative;
    overflow: hidden;
    border-left: 1px solid var(--line);
  }
  .col:first-child {
    border-left: 0;
  }

  .glyph {
    position: absolute;
    left: 0;
    right: 0;
    z-index: 1;
    font-family: var(--serif);
    font-size: var(--glyph);
    font-weight: 900;
    line-height: 0.8;
    text-align: center;
    user-select: none;
  }
  .col:nth-child(1) .glyph { top: calc((100% - var(--box)) * var(--y-a)); }
  .col:nth-child(2) .glyph { top: calc((100% - var(--box)) * var(--y-u)); }
  .col:nth-child(3) .glyph { top: calc((100% - var(--box)) * var(--y-n)); }
  .col:nth-child(4) .glyph { top: calc((100% - var(--box)) * var(--y-g)); }

  .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 25%;
    filter: grayscale(1) contrast(1.08);
  }
  /* The letter over the photo is cut in page colour, so the photo shows around it. */
  .photo-col .glyph {
    color: var(--bg);
  }
  /* Just under the U (its top plus its box plus a gap); white because it sits on the photo. */
  .hello {
    position: absolute;
    left: 0;
    right: 0;
    top: calc((100% - var(--box)) * var(--y-u) + var(--box) + 1rem);
    z-index: 2;
    margin: 0;
    padding: 0 1rem;
    color: #fff;
    font: 600 0.75rem/1.4 system-ui, sans-serif;
    letter-spacing: 0.08em;
    text-align: center;
    text-transform: uppercase;
  }

  .copy {
    position: absolute;
    right: 0.875rem;
    bottom: 1.5rem;
    color: var(--muted);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  /* Sits under the N in column 3 (its top, plus its 0.8 line-height box, plus a gap); its own block on phones. */
  .caption {
    position: absolute;
    left: 50%;
    top: calc((100% - var(--box)) * var(--y-n) + var(--box) + 2rem);
    z-index: 2;
    width: 25%;
    padding: 0 2.5rem;
  }
  /* Name: the clearest line in the caption, but small next to the giant letters. */
  h1 {
    margin: 0 0 0.375rem;
    font-family: var(--serif);
    font-size: 1.25rem;
    font-weight: 900;
    line-height: 1.2;
  }
  .caption p {
    margin: 0;
    max-width: 22rem;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.5;
    text-wrap: pretty;
  }
  /* A plain text link: muted until hovered, underlined so it reads as clickable. */
  .caption a {
    display: inline-block;
    line-height: 40px;
    margin-top: 0.25rem;
    color: var(--muted);
    font-size: 0.9375rem;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .caption a:hover,
  .caption a:focus-visible {
    color: var(--fg);
  }

  /* Phone-only small AUNG, in the same sine pattern as the desktop columns. */
  .caption .wave {
    display: none;
  }

  /* Phones: one clean photo fading into the page, with a frosted panel overlapping its lower part. */
  @media (max-width: 48rem) {
    .hero {
      grid-template-columns: 1fr;
      height: auto;
      border-top: 0;
    }
    .col:not(.photo-col),
    .photo-col .glyph,
    .hello {
      display: none;
    }
    .photo-col {
      aspect-ratio: 0.78;
      border-left: 0;
    }
    .photo {
      mask-image: linear-gradient(to bottom, #000 70%, transparent);
    }
    .caption {
      position: relative;
      top: auto;
      left: auto;
      width: auto;
      margin: -9rem 1rem 0;
      padding: 1rem 1.25rem 0.5rem;
      border: 1px solid color-mix(in srgb, var(--fg) 12%, transparent);
      border-radius: var(--radius-card);
      background: color-mix(in srgb, var(--bg) 55%, transparent);
      backdrop-filter: blur(14px);
    }
    .caption .wave {
      display: flex;
      gap: 0.125rem;
      margin: 0 0 1.75rem;
      color: var(--fg);
      font: 900 3rem/0.8 var(--serif);
    }
    .caption .wave span:nth-child(2) { transform: translateY(0.5rem); }
    .caption .wave span:nth-child(3) { transform: translateY(-0.5rem); }
    .caption .wave span:nth-child(4) { transform: translateY(1rem); }
  }
</style>
